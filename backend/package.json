{
  "name": "sweet-feet-backend",
  "version": "1.0.0",
  "description": "Sweet Feet multi-vendor footwear marketplace API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "rm -rf dist && tsc-watch --noClear -p tsconfig.json --onSuccess \"node ./dist/server.js\"",
    "build": "tsc -p tsconfig.json",
    "postinstall": "tsc -p tsconfig.json"
  },
  "keywords": ["NodeJs", "Typescript", "Express", "MongoDb", "SweetFeet"],
  "author": "Deviant08",
  "license": "ISC",
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.5.1",
    "helmet": "^5.1.1",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.3.5",
    "morgan": "^1.10.0",
    "validator": "^13.7.0",
    "xss-clean": "^0.1.1",
    "axios": "^0.27.2",
    "slugify": "^1.6.5",
    "moment": "^2.29.4"
